# Keep the Docker build context deterministic. Production config is bind-mounted
# and runtime state changes constantly; neither may invalidate the expensive Go
# build layer. The image carries config.yaml.example only as a standalone fallback.
downloads/
state/
config.yaml
telegram-cache.json
telegram-state.json
telegram-schedule.json
mtproto-session.json
karen-state-*.json
*.zip
*.log
